[Unit]
Description=MO-62A first-boot: install packages, resize rootfs, apply sysconfig.txt
# sysinit.target ensures udev has settled and block devices (/dev/mmcblk*) are visible.
After=sysinit.target local-fs.target NetworkManager.service
Wants=NetworkManager.service
# Configure hostname/accounts before name publication and X11 authentication.
# Do not wait for network-online: offline and direct Ethernet boots must work.
Before=avahi-daemon.service lightdm.service mo-discover.service
ConditionPathExists=!/opt/ti/.edgeai-installed

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/sbin/mo-62a-firstboot-install.sh
StandardOutput=journal+console
StandardError=journal+console
# Package install + resize + sysconfig can take several minutes on first boot.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
